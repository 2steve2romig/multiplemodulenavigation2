# Supabase — server-only. Never prefix with NEXT_PUBLIC_ or VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin endpoint pre-auth secret (ADR-006).
# Required before the platform API is publicly deployed.
ADMIN_SECRET=change-me-before-deploy

# CORS — comma-separated list of allowed origins.
# Production: your Vercel domain(s) only. Never use *.
ALLOWED_ORIGINS=https://multiplemodulenavigation2.vercel.app

# Node environment
NODE_ENV=development
